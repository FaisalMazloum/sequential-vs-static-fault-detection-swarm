.unity-base-slider {
    background-color: rgba(0, 0, 0, 0.21);
}

.unity-base-slider__text-field .unity-base-field__input {
    -unity-background-image-tint-color: rgb(112, 76, 76);
    background-color: rgba(255, 255, 255, 0);
    color: rgb(255, 255, 255);
    font-size: 10px;
    -unity-text-align: middle-center;
}
